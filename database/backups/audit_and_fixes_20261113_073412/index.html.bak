<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MY UGC VIDEO — UGC Video Production Agency for Brands | Creator-Led Content</title>
  <meta name="description"
    content="MY UGC VIDEO is a premier UGC video production agency for brands. Creator-led content, product demos, unboxing videos, testimonials, and performance marketing video ads.">
  <link rel="canonical" href="https://myugcvideo.in/">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://myugcvideo.in/">
  <meta property="og:title" content="MY UGC VIDEO — UGC Video Production Agency for Brands">
  <meta property="og:description"
    content="Creator-led content. Made for brands. Authentic UGC videos, product demonstrations, unboxings, and paid social video ads that drive conversions.">
  <meta property="og:image" content="https://myugcvideo.in/images/hero/hero-ugc-production.jpg">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="MY UGC VIDEO — UGC Video Production Agency for Brands">
  <meta name="twitter:description"
    content="Creator-led content. Made for brands. Authentic UGC videos, product demonstrations, unboxings, and paid social video ads that drive conversions.">
  <meta name="twitter:image" content="https://myugcvideo.in/images/hero/hero-ugc-production.jpg">

  <!-- Fonts & Stylesheet -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">

  <!-- JSON-LD Structured Data: Organization & Agency -->
  <!-- Centralized Schema Manager JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://myugcvideo.in/#organization",
    "name": "MY UGC VIDEO",
    "url": "https://myugcvideo.in/",
    "logo": {
        "@type": "ImageObject",
        "@id": "https://myugcvideo.in/#logo",
        "url": "https://myugcvideo.in/images/hero/hero-creator.jpg",
        "caption": "MY UGC VIDEO Studio Logo"
    },
    "description": "Premier performance-driven UGC video production studio and creator network.",
    "email": "hello@myugcvideo.in",
    "telephone": "+91-98765-43210",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Delhi",
        "addressRegion": "DL",
        "addressCountry": "IN"
    },
    "sameAs": [
        "https://instagram.com/myugcvideo",
        "https://linkedin.com/company/myugcvideo"
    ]
}
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://myugcvideo.in/#webpage",
    "url": "https://myugcvideo.in/",
    "name": "MY UGC VIDEO \u2014 Premier UGC Video Production Agency",
    "description": "High-performing user-generated content video ads, product demonstrations, and creator-led marketing campaigns.",
    "isPartOf": {
        "@id": "https://myugcvideo.in/#organization"
    },
    "about": {
        "@id": "https://myugcvideo.in/#organization"
    }
}
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://myugcvideo.in/#service-core",
    "name": "UGC Video Production Services",
    "serviceType": "User Generated Content Video Advertising",
    "provider": {
        "@id": "https://myugcvideo.in/#organization"
    },
    "description": "End-to-end UGC video production covering creator casting, creative brief development, scriptwriting, professional editing, and performance ad creative delivery.",
    "areaServed": {
        "@type": "Country",
        "name": "India"
    },
    "url": "https://myugcvideo.in/"
}
  </script>
</head>

<body>

  <!-- =========================================================================
       1. HEADER / NAVIGATION (Consistent Website-Wide Hierarchy)
       ========================================================================= -->
  <header class="site-header" role="banner">
