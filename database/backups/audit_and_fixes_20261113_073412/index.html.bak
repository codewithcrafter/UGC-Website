    <!-- =========================================================================
         SECTION 10 — FINAL CONVERSION CTA & IN-PAGE PROJECT INQUIRY FORM
         ========================================================================= -->
    <section class="section about-cta-section homepage-final-cta-section" id="final-cta" aria-labelledby="cta-heading">
      <div class="container">
        <div class="about-cta-card">
          <div class="cta-glow-mesh" aria-hidden="true"></div>

          <div class="about-eyebrow-wrap">
            <span class="about-eyebrow">
              <span class="eyebrow-circle-dot" aria-hidden="true"></span>LET’S WORK TOGETHER
            </span>
          </div>

          <h2 id="cta-heading" class="about-cta-title font-display">
            Ready to Make Videos That Sell?

          </h2>

          <p class="about-cta-desc">
            Work with vetted creators, test more ad ideas and get videos built for performance marketing.

          </p>

          <div class="about-cta-actions">
            <a href="#project-inquiry" class="btn btn-primary btn-lg">START YOUR PROJECT</a>
            <a href="contact.html?type=creator" class="btn btn-secondary btn-lg">JOIN AS CREATOR</a>
          </div>

          <!-- In-Page Project Inquiry Form -->
          <div class="homepage-inquiry-box" id="project-inquiry">
            <div class="inquiry-box-header text-center">
              <span class="inquiry-box-tag font-display">QUICK PROJECT INQUIRY</span>
              <h3 class="inquiry-box-title font-display">Tell Us About Your Project</h3>
              <p class="inquiry-box-sub">Fill in this short brief and our creative director will reply within 24 hours.
              </p>
            </div>

            <form id="projectInquiryForm" class="inquiry-form-layout" novalidate>
              <input type="text" name="website_hp" style="display:none !important;" tabindex="-1" autocomplete="off">
              <div class="inquiry-form-grid">

                <div class="form-group">
                  <label for="inquiryName" class="form-label">Your Name <span class="required">*</span></label>
                  <input type="text" id="inquiryName" name="name" class="form-input" placeholder="e.g. Alex Morgan"
                    required>
                  <span class="form-error-msg" aria-live="polite"></span>
                </div>

                <div class="form-group">
                  <label for="inquiryEmail" class="form-label">Work Email <span class="required">*</span></label>
                  <input type="email" id="inquiryEmail" name="email" class="form-input" placeholder="alex@yourbrand.com"
                    required>
                  <span class="form-error-msg" aria-live="polite"></span>
                </div>

                <div class="form-group">
                  <label for="inquiryBrand" class="form-label">Brand Name or Website <span
                      class="required">*</span></label>
                  <input type="text" id="inquiryBrand" name="brand" class="form-input"
                    placeholder="e.g. Acme Botanics (acme.com)" required>
                  <span class="form-error-msg" aria-live="polite"></span>
                </div>

                <div class="form-group">
                  <label for="inquiryService" class="form-label">Primary Content Need <span
                      class="required">*</span></label>
                  <select id="inquiryService" name="service" class="form-input form-select" required>
                    <option value="" disabled selected>Select service type...</option>
                    <option value="ugc-video-creation">UGC Video Creation Services</option>
                    <option value="ugc-video-ads">UGC Video Ads</option>
                    <option value="ai-ugc-video">AI UGC Video Creation</option>
                    <option value="ugc-product-video">UGC Product Video</option>
                    <option value="ugc-product-reviews">UGC Product Reviews Videos</option>
                    <option value="ugc-video-delhi">UGC Video Company in Delhi</option>
                    <option value="ugc-unboxing">UGC Unboxing Videos</option>
                    <option value="ugc-testimonials">UGC Testimonial Videos</option>
                    <option value="ugc-editing">UGC Video Editing Service</option>
                    <option value="other">Other / Custom Collaboration</option>
                  </select>
                  <span class="form-error-msg" aria-live="polite"></span>
                </div>

                <div class="form-group full-width">
                  <label for="inquiryBudget" class="form-label">Estimated Monthly Video Budget</label>
                  <select id="inquiryBudget" name="budget" class="form-input form-select">
                    <option value="under-2500">Under $2,500 / ₹2,00,000</option>
                    <option value="2500-5000" selected>$2,500 – $5,000 / ₹2,00,000 – ₹4,00,000</option>
                    <option value="5000-10000">$5,000 – $10,000 / ₹4,00,000 – ₹8,00,000</option>
                    <option value="10000-plus">$10,000+ / ₹8,00,000+ (Scale)</option>
                  </select>
                </div>

                <div class="form-group full-width">
                  <label for="inquiryDetails" class="form-label">Project Details &amp; Objectives <span
                      class="required">*</span></label>
                  <textarea id="inquiryDetails" name="details" class="form-input form-textarea" rows="4"
                    placeholder="Briefly describe your product, target audience, preferred platforms (TikTok, Reels, Meta Ads), and timeline..."
                    required></textarea>
                  <span class="form-error-msg" aria-live="polite"></span>
                </div>

              </div>

              <div class="inquiry-form-footer">
                <button type="submit" class="btn btn-primary btn-lg inquiry-submit-btn">
                  <span>SEND PROJECT INQUIRY</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
                <div class="inquiry-trust-badge">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-mint)"
                    stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span>24-Hour Agency Response &bull; Strict Non-Disclosure Assured</span>
                </div>
              </div>

              <!-- Status Alert for Success or Error -->
              <div id="inquiryStatusAlert" class="inquiry-status-alert" role="alert" style="display: none;"></div>
            </form>
          </div>

        </div>
      </div>
    </section>

  </main>

