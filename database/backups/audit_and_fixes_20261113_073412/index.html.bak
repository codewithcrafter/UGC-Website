            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="mobile-dropdown-content">
          <a href="services/ugc-video-creation-services-company" class="mobile-sub-link">&bull; UGC Video Creation Services</a>
