                <a href="blog/brand-identity-through-content" class="slider-link-action">Read Article &rarr;</a>
              </div>
            </div>
          </article>

          <!-- Right Column: Two Supporting Articles Stacked -->
          <div class="journal-side-stack">

            <!-- Supporting Article 1: Instagram and TikTok Strategy -->
            <article class="journal-side-card" data-category="marketing-tips">
              <div class="journal-side-media camera-focus-media">
                <img src="images/blogs/blog-9.jpg"
                  alt="Content strategist analyzing TikTok analytics dashboard and retention curves" width="240"
                  height="170" loading="lazy">
                <span class="category-pill-badge">Marketing Tips</span>
              </div>
              <div class="journal-side-body">
                <div class="blog-meta-compact">
                  <span>October 28, 2026</span>
                  <span>&bull;</span>
                  <span>9 Min Read</span>
                </div>
                <h3 class="journal-side-title font-display">
                  <a href="blog/ugc-instagram-tiktok-strategy">A Simple UGC Strategy for Instagram and TikTok

                  </a>
                </h3>
                <p class="journal-side-excerpt">
                  See how video works differently on TikTok, Reels and YouTube Shorts, and how to plan for each one.
                </p>
                <div class="blog-card-footer">
                  <span class="blog-card-author">By MY UGC VIDEO</span>
                  <a href="blog/ugc-instagram-tiktok-strategy" class="slider-link-action">Read Article &rarr;</a>
                </div>
              </div>
            </article>

            <!-- Supporting Article 2: Psychology of Authenticity -->
            <article class="journal-side-card" data-category="ugc-trends">
              <div class="journal-side-media camera-focus-media">
                <img src="images/blogs/blog-8.jpg"
                  alt="Shopper engaging with authentic consumer reviews on smartphone screen" width="240" height="170"
                  loading="lazy">
                <span class="category-pill-badge">UGC Trends

                </span>
              </div>
              <div class="journal-side-body">
                <div class="blog-meta-compact">
                  <span>October 27, 2026</span>
                  <span>&bull;</span>
                  <span>10 Min Read</span>
                </div>
                <h3 class="journal-side-title font-display">
                  <a href="blog/authentic-content-and-buying-decisions">Why Real People Sell Better Than Ads

