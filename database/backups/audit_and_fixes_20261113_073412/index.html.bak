  <main id="main-content">

    <!-- =========================================================================
         SECTION 01 — HERO (PREMIUM UGC IMAGE WITH SUBTLE SIDE REFLECTION)
         ========================================================================= -->
    <section class="section hero-homepage" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-agency-split">

          <!-- Left side: Content -->
          <div class="hero-content">
            <div class="hero-eyebrow-wrap">
              <span class="hero-eyebrow">
                <span class="eyebrow-circle-dot" aria-hidden="true"></span>REAL CREATORS. REAL VIDEOS.
              </span>
            </div>

            <h1 id="hero-title" class="hero-headline font-display">
              Your Product.<br>
              Our Creators.<br>
              <span class="highlight-mint">Videos People Actually Watch.</span>
            </h1>

            <p class="hero-description">
              MY UGC VIDEO matches brands with creators who film honest, phone-style videos. From unboxings and reviews
              to video ads ready to run, we handle the brief, the creators and the editing. You get content that fits
              TikTok, Reels and Meta ads.
            </p>

            <div class="hero-cta-group">
              <a href="contact" class="btn btn-primary btn-lg">HIRE UGC CREATORS</a>
              <a href="contact.html?type=creator" class="btn btn-secondary btn-lg">BECOME A CREATOR</a>
            </div>
          </div>

          <!-- Right side: Clean Portrait UGC Visual with Subtle Side Reflection -->
          <div class="hero-visual-column">
            <div class="hero-visual-stage">
              <!-- Ambient Radial Glow -->
              <div class="hero-visual-glow" aria-hidden="true"></div>

              <!-- Subtle Side Reflection (Visual Echo) -->
              <div class="hero-reflection-wrap" aria-hidden="true">
                <div class="hero-reflection-card">
                  <img src="images/hero/hero-ugc-production.jpg" alt="" class="hero-reflection-img">
                  <div class="hero-reflection-fade"></div>
                </div>
              </div>

              <!-- Main Vertical UGC Portrait Card -->
              <div class="hero-portrait-card">
                <div class="hero-portrait-media camera-focus-media">
                  <img src="images/hero/hero-ugc-production.jpg"
                    alt="Creator producing authentic UGC video content for brands" width="420" height="650"
                    loading="eager" fetchpriority="high">

                  <div class="hero-portrait-overlay">
                    <!-- Subtle top highlight pill -->
                    <div class="hero-portrait-top">
                      <span class="hero-portrait-tag">
                        <span class="eyebrow-circle-dot" aria-hidden="true"></span>
                        Creator-Led Production
                      </span>
                    </div>

                    <!-- Clean Play Indicator Trigger for Lightbox Modal -->
                    <div class="hero-portrait-center">
                      <button class="video-play-btn-pulse video-play-trigger"
                        aria-label="Watch UGC Creator Production Preview"
                        data-video-poster="images/hero/hero-ugc-production.jpg"
                        data-video-title="Creator-Led Video Production"
                        data-video-meta="Format: 9:16 Vertical UGC Video • Direct-to-Consumer Impact">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                          <polygon points="6 3 20 12 6 21 6 3"></polygon>
                        </svg>
                      </button>
                    </div>

                    <!-- Subtle bottom metadata caption -->
                    <div class="hero-portrait-bottom">
                      <span class="hero-portrait-caption">4K Native 9:16 Vertical</span>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>

        <!-- NOTE: Key agency performance metrics are editable placeholders for client tracking -->
        <div class="hero-stats-strip" aria-label="Agency Performance Metrics">
          <div class="stat-item">
            <span class="stat-number font-display">100+</span>
            <span class="stat-label">Vetted Creators</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number font-display">500+</span>
            <span class="stat-label">Videos Produced</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number font-display">50+</span>
            <span class="stat-label">Ambitious Brands</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-number font-display">4K</span>
            <span class="stat-label">Native 9:16 Vertical</span>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
         SECTION 02 — CREATIVE CAPABILITIES (WHAT WE BRING TO YOUR BRAND)
         ========================================================================= -->
    <section class="section capabilities-section" id="trust-brands" aria-labelledby="capabilities-heading">
      <div class="container">
        <div class="section-header text-center" style="max-width: 820px; margin: 0 auto clamp(2rem, 3.5vw, 3rem) auto;">
          <span class="about-eyebrow">
            <span class="eyebrow-circle-dot" aria-hidden="true"></span>OUR CAPABILITIES
          </span>
          <h2 id="capabilities-heading" class="section-title font-display">
            WHAT WE DO
          </h2>
          <p class="section-desc">
            Everything Your Brand Needs on Video<br>
            From the first idea to the final edit, we cover the creators, the filming and the story.

          </p>
        </div>

        <div class="capabilities-grid">

          <!-- Capability 01 -->
          <div class="capability-card">
            <div class="capability-top">
              <span class="capability-num font-display">01</span>
              <span class="capability-tag">PRODUCTION</span>
            </div>
            <div class="capability-divider"></div>
            <h3 class="capability-title font-display">UGC VIDEO PRODUCTION</h3>
            <p class="capability-text">
              Creator-made videos that look natural on a phone screen.
            </p>
          </div>

          <!-- Capability 02 -->
          <div class="capability-card">
            <div class="capability-top">
              <span class="capability-num font-display">02</span>
              <span class="capability-tag">VISUALS</span>
            </div>
            <div class="capability-divider"></div>
            <h3 class="capability-title font-display">PRODUCT VISUALS</h3>
            <p class="capability-text">
              Close-up demos that show texture, size and small details clearly.
            </p>
          </div>

          <!-- Capability 03 -->
          <div class="capability-card">
            <div class="capability-top">
              <span class="capability-num font-display">03</span>
              <span class="capability-tag">STORYTELLING</span>
            </div>
            <div class="capability-divider"></div>
            <h3 class="capability-title font-display">CREATOR-STYLE STORYTELLING</h3>
            <p class="capability-text">
              Videos told the way a friend would recommend a product.
            </p>
          </div>

          <!-- Capability 04 -->
          <div class="capability-card">
            <div class="capability-top">
              <span class="capability-num font-display">04</span>
              <span class="capability-tag">SOCIAL</span>
            </div>
            <div class="capability-divider"></div>
            <h3 class="capability-title font-display">SOCIAL MEDIA CONTENT</h3>
            <p class="capability-text">
              Ready-to-post videos for Instagram, TikTok and YouTube Shorts.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 03 — FEATURED UGC WORK & CATEGORY FILTERS (9:16 VERTICAL CARDS)
         ========================================================================= -->
    <section class="section section-secondary featured-work-section" id="featured-work"
      aria-labelledby="featured-work-heading">
      <div class="container">
        <div class="section-header text-center"
          style="max-width: 820px; margin: 0 auto clamp(2.5rem, 4.5vw, 3.5rem) auto;">
          <span class="about-eyebrow">
            <span class="eyebrow-circle-dot" aria-hidden="true"></span>PORTFOLIO<br>OUR WORK
          </span>
          <h2 id="featured-work-heading" class="section-title font-display">
            Videos Made to Be Watched to the End.
          </h2>
          <p class="section-desc">
            A look at vertical UGC videos made for TikTok, Instagram Reels and paid ads across skincare, beauty, tech,
            wellness and more.

          </p>
        </div>

        <!-- Interactive Category Filter Tabs -->
        <div class="portfolio-filter-tabs" role="tablist" aria-label="Portfolio Category Filters">
          <button class="portfolio-filter-btn active" role="tab" aria-selected="true" data-filter="all">All</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false" data-filter="skincare">Skincare</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false" data-filter="beauty">Beauty</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false"
            data-filter="lifestyle">Lifestyle</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false"
            data-filter="technology">Technology</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false" data-filter="wellness">Wellness</button>
          <button class="portfolio-filter-btn" role="tab" aria-selected="false" data-filter="beverage">Beverage</button>
        </div>

        <!-- 6 9:16 Vertical Creator Video Cards Grid -->
        <div class="portfolio-vertical-grid" id="portfolioProjectsGrid">

          <!-- Card 1: Wellness -->
          <article class="portfolio-project-card" data-category="wellness">
            <div class="portfolio-project-media camera-focus-media">
              <img src="images/portfolio/portfolio-wellness.jpg"
                alt="Creator showing daily wellness supplement routine in bright kitchen" width="400" height="711"
                loading="lazy">
              <div class="portfolio-card-overlay">
                <div class="portfolio-top-tags">
                  <span class="portfolio-category-pill">Wellness</span>
                  <span class="portfolio-meta-badge">SAMPLE WORK &bull; 9:16</span>
                </div>
                <div class="portfolio-play-wrap">
                  <button class="video-play-btn-pulse video-play-trigger" aria-label="Play Daily Wellness Video"
                    data-video-poster="images/portfolio/portfolio-wellness.jpg"
                    data-video-title="Daily Wellness &amp; Supplement Routine"
                    data-video-meta="Concept Spec: 9:16 In-Hand Product Routine">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </button>
                </div>
                <div class="portfolio-card-info">
                  <h3 class="portfolio-card-title font-display">A Morning Routine with a Daily Supplement</h3>
                  <p class="portfolio-card-sub">A creator shows how the supplement fits into a normal morning.
                  </p>
                </div>
              </div>
            </div>
          </article>

          <!-- Card 2: Skincare -->
          <article class="portfolio-project-card" data-category="skincare">
            <div class="portfolio-project-media camera-focus-media">
              <img src="images/portfolio/portfolio-skincare.jpg"
                alt="Cleanse and glow nighttime skincare routine application" width="400" height="711" loading="lazy">
              <div class="portfolio-card-overlay">
                <div class="portfolio-top-tags">
                  <span class="portfolio-category-pill">Skincare</span>
                  <span class="portfolio-meta-badge">SAMPLE WORK &bull; 9:16</span>
                </div>
                <div class="portfolio-play-wrap">
                  <button class="video-play-btn-pulse video-play-trigger" aria-label="Play Skincare Routine Video"
                    data-video-poster="images/portfolio/portfolio-skincare.jpg"
                    data-video-title="Cleanse &amp; Glow Night Routine"
                    data-video-meta="Concept Spec: 9:16 Direct Texture &amp; Glow Demonstration">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </button>
                </div>
                <div class="portfolio-card-info">
                  <h3 class="portfolio-card-title font-display">Night Skincare, Start to Finish </h3>
                  <p class="portfolio-card-sub">Close shots of texture, lather and how skin looks after washing.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- Card 3: Beverage -->
          <article class="portfolio-project-card" data-category="beverage">
            <div class="portfolio-project-media camera-focus-media">
              <img src="images/portfolio/portfolio-beverage.jpg"
                alt="Sensory beverage pour with ice cubes and dynamic condensation in sunlight" width="400" height="711"
                loading="lazy">
              <div class="portfolio-card-overlay">
                <div class="portfolio-top-tags">
                  <span class="portfolio-category-pill">Beverage</span>
                  <span class="portfolio-meta-badge">SAMPLE WORK &bull; 9:16</span>
                </div>
                <div class="portfolio-play-wrap">
                  <button class="video-play-btn-pulse video-play-trigger" aria-label="Play Beverage Taste Test Video"
                    data-video-poster="images/portfolio/portfolio-beverage.jpg"
                    data-video-title="First-Sip Honest Taste Experience"
                    data-video-meta="Concept Spec: 9:16 ASMR Pour &amp; Authentic Reaction">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </button>
                </div>
                <div class="portfolio-card-info">
                  <h3 class="portfolio-card-title font-display">The First Sip, Honest Reaction</h3>
                  <p class="portfolio-card-sub">The pour, the ice and the creator’s real first reaction.</p>
                </div>
              </div>
            </div>
          </article>

          <!-- Card 4: Technology -->
          <article class="portfolio-project-card" data-category="technology">
            <div class="portfolio-project-media camera-focus-media">
              <img src="images/portfolio/portfolio-tech.jpg"
                alt="Creator unboxing premium wireless headphones on modern wooden desk" width="400" height="711"
                loading="lazy">
              <div class="portfolio-card-overlay">
                <div class="portfolio-top-tags">
                  <span class="portfolio-category-pill">Technology</span>
                  <span class="portfolio-meta-badge">SAMPLE WORK &bull; 9:16</span>
                </div>
                <div class="portfolio-play-wrap">
                  <button class="video-play-btn-pulse video-play-trigger" aria-label="Play Tech Unboxing Video"
                    data-video-poster="images/portfolio/portfolio-tech.jpg"
                    data-video-title="Unboxing &amp; First-Impression Setup"
                    data-video-meta="Concept Spec: 9:16 Tactile Unboxing &amp; Feature Walkthrough">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </button>
                </div>
                <div class="portfolio-card-info">
                  <h3 class="portfolio-card-title font-display">Headphones Unboxing and Setup</h3>
                  <p class="portfolio-card-sub">Opening the box, pairing in seconds and an honest comfort review.
                  </p>
                </div>
              </div>
            </div>
          </article>

          <!-- Card 5: Lifestyle / Fashion -->
          <article class="portfolio-project-card" data-category="lifestyle">
            <div class="portfolio-project-media camera-focus-media">
              <img src="images/portfolio/portfolio-fashion.jpg"
                alt="Fashion creator trying on aesthetic streetwear outfit in modern urban apartment" width="400"
                height="711" loading="lazy">
