    <!-- =========================================================================
         SECTION 07 — HOW IT WORKS (FOUR-STEP STRATEGIC PROCESS)
         ========================================================================= -->
    <section class="section how-it-works-section" id="how-it-works" aria-labelledby="how-it-works-heading">
      <div class="container">
        <div class="section-header text-center"
          style="max-width: 820px; margin: 0 auto clamp(2.5rem, 4.5vw, 4rem) auto;">
          <span class="about-eyebrow">
            <span class="eyebrow-circle-dot" aria-hidden="true"></span>OUR PROCESS
          </span>
          <h2 id="how-it-works-heading" class="section-title font-display">
            From Idea to Finished Video in 4 Steps
          </h2>
          <p class="section-desc">
            A simple workflow, from your brief to videos that are ready to run as ads.
          </p>
        </div>

        <div class="process-horizontal-timeline process-4-steps">

          <!-- Step 01 -->
          <div class="process-step-item" aria-label="STEP 01 — SHARE YOUR VISION">
            <div class="process-step-badge font-display">
              <span class="step-num">01</span>
              <div class="step-icon-wrap" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
            </div>
            <div class="process-step-content">
              <span class="process-step-label">STEP 01</span>
              <h3 class="process-step-title font-display">Share Your Brief</h3>
              <p class="process-step-text">
                Tell us your goals, your audience, your product and the videos you need, using our short brief form.
              </p>
            </div>
          </div>

          <!-- Step 02 -->
          <div class="process-step-item" aria-label="STEP 02 — MATCH WITH CREATORS">
            <div class="process-step-badge font-display">
              <span class="step-num">02</span>
              <div class="step-icon-wrap" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
            </div>
            <div class="process-step-content">
              <span class="process-step-label">STEP 02</span>
              <h3 class="process-step-title font-display">Meet Your Creators</h3>
              <p class="process-step-text">
                We match you with vetted creators who fit your product and your customers.
              </p>
            </div>
          </div>

          <!-- Step 03 -->
          <div class="process-step-item" aria-label="STEP 03 — CREATE AUTHENTIC CONTENT">
            <div class="process-step-badge font-display">
              <span class="step-num">03</span>
              <div class="step-icon-wrap" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              </div>
            </div>
            <div class="process-step-content">
              <span class="process-step-label">STEP 03</span>
              <h3 class="process-step-title font-display">Creators Film</h3>
              <p class="process-step-text">
                Creators get your product and film the hooks, demos and reviews, while our team guides the creative
                direction.
              </p>
            </div>
          </div>

          <!-- Step 04 -->
          <div class="process-step-item" aria-label="STEP 04 — LAUNCH & SCALE">
            <div class="process-step-badge font-display">
              <span class="step-num">04</span>
              <div class="step-icon-wrap" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
            </div>
            <div class="process-step-content">
              <span class="process-step-label">STEP 04</span>
              <h3 class="process-step-title font-display">Launch and Scale</h3>
              <p class="process-step-text">
                You receive edited 4K vertical videos with commercial usage rights, ready for TikTok, Reels and Meta
                Ads.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 08 — CREATIVE PHILOSOPHY (EDITORIAL SPLIT + 3 COMPACT POINTS)
         ========================================================================= -->
    <section class="section section-secondary creative-approach-section" id="creative-approach"
      aria-labelledby="approach-heading">
      <div class="container">
        <div class="section-header text-center"
          style="max-width: 820px; margin: 0 auto clamp(2.5rem, 4.5vw, 4rem) auto;">
          <span class="about-eyebrow">
            <span class="eyebrow-circle-dot" aria-hidden="true"></span>CREATIVE PHILOSOPHY
          </span>
          <h2 id="approach-heading" class="section-title font-display">
            Content That Feels Real Gets Remembered.
          </h2>
          <p class="section-desc">
            Good content starts with knowing your brand, your buyers and the story worth telling.
          </p>
        </div>

        <!-- Editorial Split Layout: Left Bold Intro + Right Cinematic UGC Visual -->
        <div class="philosophy-split-layout">
          <div class="philosophy-editorial-text">
            <span class="philosophy-quote-glyph font-display" aria-hidden="true">&ldquo;</span>
            <h3 class="philosophy-lead-heading font-display">
              People trust videos that feel real.
            </h3>
            <p class="philosophy-lead-body">
              Most people scroll past polished ads in a second. A creator talking naturally, showing the product and
              giving an honest opinion holds attention much longer.And that is how we shoot every project.
            </p>
            <div class="philosophy-editorial-badge">
              <span class="badge-dot-indicator"></span>
              <span>CREATOR-FIRST &bull; WELL PRODUCED</span>
            </div>
          </div>

          <div class="philosophy-cinematic-visual">
            <div class="philosophy-media-frame camera-focus-media">
              <img src="images/about/about-creative.jpg"
                alt="Creative director and creator reviewing video footage on set" width="580" height="380"
                loading="lazy">
              <div class="philosophy-media-overlay">
                <span class="philosophy-caption-pill">Real People &bull; Real Proof</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Below: Three Compact Philosophy Points -->
        <div class="philosophy-points-grid">

          <!-- Point 01 -->
          <div class="philosophy-point-card">
            <div class="philosophy-point-top">
              <span class="philosophy-point-num font-display">01</span>
              <span class="philosophy-point-tag">STRATEGY</span>
            </div>
            <h4 class="philosophy-point-title font-display">Creative Strategy</h4>
            <p class="philosophy-point-desc">
              We plan video ideas around your goals, your audience and the platform.
            </p>
            <div class="philosophy-point-footer">
              <span class="philosophy-point-pill">Audience Intent &bull;Right Format</span>
            </div>
          </div>

          <!-- Point 02 -->
          <div class="philosophy-point-card">
            <div class="philosophy-point-top">
              <span class="philosophy-point-num font-display">02</span>
              <span class="philosophy-point-tag">STORYTELLING </span>
            </div>
            <h4 class="philosophy-point-title font-display">Honest Storytelling</h4>
            <p class="philosophy-point-desc">
              Natural, conversational videos that show real proof.

            </p>
            <div class="philosophy-point-footer">
              <span class="philosophy-point-pill">Natural Tone &bull; Real Proof</span>
            </div>
          </div>

          <!-- Point 03 -->
          <div class="philosophy-point-card">
            <div class="philosophy-point-top">
              <span class="philosophy-point-num font-display">03</span>
              <span class="philosophy-point-tag">DELIVERY</span>
            </div>
            <h4 class="philosophy-point-title font-display">Brand-Focused Content</h4>
            <p class="philosophy-point-desc">
              Videos that carry your brand’s look, voice and message.
            </p>
            <div class="philosophy-point-footer">
              <span class="philosophy-point-pill">Brand Identity &bull; Campaign Goal</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =========================================================================
         SECTION 09 — THE CREATOR JOURNAL (DIGITAL MAGAZINE LAYOUT)
         ========================================================================= -->
    <section class="section creator-journal-section" id="creator-journal" aria-labelledby="journal-heading">
      <div class="container">
        <div class="section-header text-center"
          style="max-width: 820px; margin: 0 auto clamp(2.5rem, 4.5vw, 4rem) auto;">
          <span class="about-eyebrow">
            <span class="eyebrow-circle-dot" aria-hidden="true"></span>THE CREATOR JOURNAL
          </span>
          <h2 id="journal-heading" class="section-title font-display">
            Ideas and Tips from the World of UGC
          </h2>
          <p class="section-desc">
            Practical advice on UGC, content creation and brand storytelling.
          </p>
        </div>

        <!-- Digital Magazine Layout: 1 Large Featured Article + 2 Smaller Supporting Articles Stacked -->
        <div class="journal-magazine-layout">

          <!-- Left Column: Large Featured Article -->
          <article class="journal-featured-card" data-category="brand-stories">
            <div class="journal-featured-media camera-focus-media">
              <img src="images/blogs/blog-10.jpg"
                alt="Creative director organizing brand visual assets and video style guidelines" width="620"
                height="380" loading="lazy">
              <span class="category-pill-badge">Brand Stories</span>
            </div>
            <div class="journal-featured-body">
              <div class="blog-meta-compact">
                <span>October 29, 2026</span>
                <span>&bull;</span>
                <span>8 Min Read</span>
              </div>
              <h3 class="journal-featured-title font-display">
                <a href="blog/brand-identity-through-content">How to Keep Your Brand Look Consistent Across Creators</a>
              </h3>
              <p class="journal-featured-excerpt">
                Learn how to keep your brand identity steady while working with different creators on TikTok, Instagram
                and paid ads.
              </p>
              <div class="blog-card-footer">
