# =========================================================================
# MY UGC VIDEO - Hostinger Production Environment Configuration (.env)
# =========================================================================
# Copy this file to .env on Hostinger and insert your actual credentials
# generated in Hostinger hPanel -> Databases -> Management.
#
# SECURITY: Never commit actual production credentials to version control.
# If your Hostinger structure allows, store .env in the parent directory
# above public_html; otherwise store in public_html with .htaccess protection.
# =========================================================================

APP_ENV=production
APP_URL=https://myugcvideo.in

# Hostinger Database Configuration
# In Hostinger, DB_HOST is usually 'localhost'
DB_HOST=[ACTUAL_HOSTINGER_DB_HOST]
DB_PORT=3306
DB_NAME=[ACTUAL_HOSTINGER_DB_NAME]
DB_USER=[ACTUAL_HOSTINGER_DB_USER]
DB_PASS=[ACTUAL_HOSTINGER_DB_PASSWORD]

# File Upload Limit in Bytes (5242880 = 5MB)
MAX_UPLOAD_SIZE=5242880
