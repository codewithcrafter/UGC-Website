# Protect schema directory from script execution
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
