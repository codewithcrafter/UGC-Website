# =========================================================================
# MY UGC VIDEO - Environment Configuration Template (.env.example)
# =========================================================================
# Copy this file to '.env' on each server and configure independently.
# Do NOT commit your actual .env file with real credentials to Git.
# =========================================================================

# -------------------------------------------------------------------------
# OPTION 1: For Local Development (XAMPP)
# -------------------------------------------------------------------------
# APP_ENV=local
# APP_URL=http://localhost/UGC%20Website
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=my_ugc_video_cms
# DB_USER=root
# DB_PASS=

# -------------------------------------------------------------------------
# OPTION 2: For Production Deployment (Hostinger)
# -------------------------------------------------------------------------
# APP_ENV=production
# APP_URL=https://myugcvideo.in
# DB_HOST=[HOSTINGER_DATABASE_HOST]
# DB_PORT=3306
# DB_NAME=[HOSTINGER_DATABASE_NAME]
# DB_USER=[HOSTINGER_DATABASE_USERNAME]
# DB_PASS=[HOSTINGER_DATABASE_PASSWORD]

# Active Environment Setting (Set to 'local' or 'production')
APP_ENV=local
APP_URL=http://localhost/UGC%20Website

# Database Connection Placeholders
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_ugc_video_cms
DB_USER=root
DB_PASS=

# Upload Configuration
MAX_UPLOAD_SIZE=5242880
