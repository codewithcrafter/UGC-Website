# MY UGC VIDEO - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

APP_ENV=development
APP_URL=http://localhost/UGC%20Website

# Database Connection (XAMPP Defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_ugc_video_cms
DB_USER=root
DB_PASS=

# Max Upload Size (Bytes, e.g. 5242880 = 5MB)
MAX_UPLOAD_SIZE=5242880

